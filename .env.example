# Variaveis de ambiente do sistema de Auditoria Automatizada de Atendimentos.
# Na Vercel: Settings > Environment Variables (uma linha = uma variavel).
# Nao coloque valores reais neste arquivo: ele vai para o GitHub.

# Banco Postgres (Neon). A Vercel cria esta sozinha ao conectar o banco em Storage.
# Sem ela, o sistema usa o SQLite local (instance/auditoria.db).
DATABASE_URL=postgresql://usuario:senha@host/banco?sslmode=require

# Chave secreta das sessoes. Gere com:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
AUDITORIA_SECRET_KEY=

# Administrador inicial. Criado automaticamente na primeira inicializacao,
# somente se ainda nao existir nenhum administrador. Depois disso estas
# variaveis sao ignoradas (podem ate ser apagadas).
AUDITORIA_ADMIN_USUARIO=admin
AUDITORIA_ADMIN_SENHA=
AUDITORIA_ADMIN_EMAIL=
AUDITORIA_ADMIN_NOME=Administrador

# Marca exibida nas telas (opcional).
SISTEMA_NOME=Auris
SISTEMA_SLOGAN=Auditoria Automatizada de Atendimentos
